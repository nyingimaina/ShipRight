{
  "pack": ".devteam/pack",
  "agent": {
    "runtime": "opencode",
    "command": "opencode",
    "args": [
      "run",
      "--format",
      "json",
      "--dir",
      "{dir}",
      "{prompt}"
    ],
    "discussArgs": [
      "--agent",
      "plan",
      "--prompt",
      "{prompt}"
    ],
    "model": "opencode-go/deepseek-v4.1-flash",
    "timeoutSeconds": 900,
    "ceilingSeconds": 7200,
    "stallSeconds": 900,
    "ceiling": "02:00:00",
    "stallWindowSeconds": 900,
    "roles": {
      "analyst": {
        "runtime": "claude-code"
      },
      "architect": {
        "runtime": "claude-code"
      }
    }
  },
  "limits": {
    "maxRevisionRounds": 2,
    "maxDefineRounds": 2,
    "volatilePaths": [],
    "planReview": true,
    "maxPlanReviewRounds": 1,
    "maxArtifactAttempts": 2,
    "budgetUsd": 10,
    "parallelChallengers": true,
    "baselineChecks": true,
    "tidyStrayFiles": true,
    "quietGraceSeconds": 300,
    "noProgressMinutes": 20,
    "progressPollSeconds": 15,
    "quickCheckSeconds": 30,
    "learnedTiers": true,
    "analystQuestionBudget": 8,
    "analystQuestionCap": 12,
    "maxAssumedTopics": 3,
    "strictRequirements": true,
    "maxRequirements": 25,
    "requirementsSignOff": true,
    "maxSignOffChanges": 3,
    "offerDocumentation": true,
    "documentByDefault": false,
    "stageMinutes": 45
  }
}