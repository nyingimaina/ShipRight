# ── ShipRight Cloud ───────────────────────────────────────────────────────────
# Copy this file to .env and adjust before running docker compose up.

SHIPRIGHT__MODE=Cloud
SHIPRIGHT__TIME_ZONE=UTC

# MariaDB connection string (host = service name from docker-compose)
SHIPRIGHT__DB_CONNECTION=Server=db;Port=3306;Database=shipright;User Id=shipright;Password=XApnFP2XgVjnpxcD;Charset=utf8;ConvertZeroDateTime=True;

# JWT signing key – generate with: openssl rand -base64 32
SHIPRIGHT__JWT_KEY=E+X/F+XoKxZ2qAVbQWT2082OnQ1O9WzgkYYhNax8+fc=

# Admin credentials (created on first run if they don't exist)
SHIPRIGHT__ADMIN_EMAIL=admin@example.com
SHIPRIGHT__ADMIN_PASSWORD=changeme

# CORS origins – comma-separated, no trailing slash
SHIPRIGHT__CORS_ORIGINS=http://localhost:5200,https://shipright.jaribio.biz

# Password reset email delivery (required for cloud password reset)
SHIPRIGHT__PUBLIC_URL=https://shipright.jaribio.biz
SHIPRIGHT__SMTP_HOST=smtp.example.com
SHIPRIGHT__SMTP_PORT=587
SHIPRIGHT__SMTP_USERNAME=shipright@example.com
SHIPRIGHT__SMTP_PASSWORD=changeme
SHIPRIGHT__SMTP_FROM=shipright@example.com

# ── MariaDB (docker-compose only) ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=mAVkbHsjHKaDR3B4
MYSQL_DATABASE=shipright
MYSQL_USER=shipright
MYSQL_PASSWORD=XApnFP2XgVjnpxcD
