# ── ShipRight Cloud ───────────────────────────────────────────────────────────
# Copy this file to .env and adjust before running docker compose up.
# Every value below is a placeholder: replace each one before you start the server.

SHIPRIGHT__MODE=Cloud
SHIPRIGHT__TIME_ZONE=UTC

# MariaDB connection string (host = service name from docker-compose).
# The password here must match MYSQL_PASSWORD at the bottom.
SHIPRIGHT__DB_CONNECTION=Server=db;Port=3306;Database=shipright;User Id=shipright;Password=changeme;Charset=utf8;ConvertZeroDateTime=True;

# CORS origins – comma-separated, no trailing slash
SHIPRIGHT__CORS_ORIGINS=https://shipright.example.com

# Password reset email delivery (the forgot-password link is sent from here)
SHIPRIGHT__PUBLIC_URL=https://shipright.example.com
SHIPRIGHT__SMTP_HOST=smtp.example.com
SHIPRIGHT__SMTP_PORT=587
SHIPRIGHT__SMTP_USERNAME=shipright@example.com
SHIPRIGHT__SMTP_PASSWORD=changeme
SHIPRIGHT__SMTP_FROM=shipright@example.com

# Sign in with Google (optional – leave both empty to hide the Google button).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials and add
# <PUBLIC_URL>/api/auth/google/callback as an authorised redirect URI.
SHIPRIGHT__GOOGLE_CLIENT_ID=
SHIPRIGHT__GOOGLE_CLIENT_SECRET=

# ── MariaDB (docker-compose only) ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=shipright
MYSQL_USER=shipright
MYSQL_PASSWORD=changeme
