# .NET build artifacts
**/bin/
**/obj/
*.user
*.suo
.vs/
*.sln.docstates
*.cache

# .NET test results
**/TestResults/
*.trx
*.coverage

# Environment / secrets
.env
.env.local
.env*.local
*.pem
*.key

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Node / Next.js (covered per-directory by front-end/.gitignore, duplicated here as fallback)
node_modules/
.next/
out/
coverage/

# ShipRight runtime data (stored in ~/.shipright, not in repo)
# (no action needed — data dir is outside the repo)

# InnoSetup build artifacts
publish/
installer/

# AI-tooling local state / per-machine overrides (never ship these)
.claude/
.opencode/settings.local.json

# Ad-hoc API-compat scratch project (back-end/temp-apicheck/)
back-end/temp-apicheck/

# Backend wwwroot (regenerated from front-end/out/ by build.sh — keep only the
# static fallback placeholders, per BRS note 11)
back-end/ShipRight.Server/wwwroot/*
!back-end/ShipRight.Server/wwwroot/index.html
!back-end/ShipRight.Server/wwwroot/404.html
